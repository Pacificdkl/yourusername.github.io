# Spin — environment template. Copy to .env.local and fill in.
# NEVER commit real values. NEVER add keys that capture request payloads
# (non-negotiable #8).

# --- Database (PostgreSQL, EU/UK region — verify the DB region, not just app) ---
# When set, the app uses the PgStore adapter; unset falls back to the in-memory
# store (dev/test only — refused at production runtime). Connect as a dedicated
# application role WITHOUT BYPASSRLS so the RLS policies are enforced.
DATABASE_URL="postgres://user:password@localhost:5432/spin"

# --- Auth ---
# Passkey (WebAuthn) relying-party identity.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Spin"
WEBAUTHN_ORIGIN="http://localhost:3000"
# Session signing key (rotate on leak). 32+ random bytes, base64.
SESSION_SECRET=""

# --- Encryption at rest ---
# 32-byte key, base64, for AES-256-GCM field encryption of boundary_answers and
# session_draws (§5). REQUIRED in production. In prod use a KMS-wrapped key.
DATA_ENCRYPTION_KEY=""

# --- Age assurance (third-party only: Yoti, Persona, Veriff, Stripe Identity) ---
# Offer at least two methods. The stub provider needs no keys.
VERIFY_PROVIDER="stub"           # stub | persona | stripe-identity
VERIFY_PROVIDER_API_KEY=""
VERIFY_PROVIDER_WEBHOOK_SECRET=""

# --- Region / hosting guard ---
DEPLOY_REGION="eu-west"
